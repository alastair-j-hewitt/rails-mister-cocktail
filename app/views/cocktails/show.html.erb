<div class="container">
  <h1><%= @cocktail.name %></h1>

  <% if @doses.any? %>
    <ul>
      <% @doses.each do |dose| %>
        <li>
          <%= dose.description %> <%= dose.ingredient.name %>
          <%= link_to "remove", dose_path(dose), method: :delete, data: { confirm: "Remove this ingredient?" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No ingredients yet.</p>
  <% end %>

  <%= link_to "Add an ingredient", new_cocktail_dose_path(@cocktail), class: "btn btn-primary" %>
  <%= link_to "All cocktails", cocktails_path %>
</div>
